{
  "name": "node-boilerplate",
  "version": "1.0.0",
  "main": "src/server.js",
  "repository": "git@github.com:SaroarShahan/node-boilerplate.git",
  "author": "SaroarShahan",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migration:gen": "sequelize-cli migration:generate --name",
    "model:gen": "sequelize-cli model:generate --name"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "sequelize": {
      "uuid": "14.0.1"
    }
  }
}